[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.4
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://rust-interface/target/debug/librust_interface.so"
linux.release.x86_64 =   "res://rust-interface/target/debug/librust_interface.so"

[icons]
AudioMeshNode = "res://addons/audio_processor/AudioMeshNode.svg"
AudioSourceNode = "res://addons/audio_processor/AudioSourceNode.svg"
AudioListenerNode = "res://addons/audio_processor/AudioListenerNode.svg"
